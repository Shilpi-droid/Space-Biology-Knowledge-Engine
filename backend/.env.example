# Space Biology Knowledge Engine - Environment Configuration

# Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# API Keys (Optional - for LLM services)
OPENAI_API_KEY=your_openai_api_key_here

# NASA ADS API (Required for data collection)
NASA_ADS_TOKEN=your_nasa_ads_api_token_here

# External API Endpoints
OSDR_BASE_URL=https://osdr.nasa.gov/osdr/data
PMC_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NTRS_BASE_URL=https://ntrs.nasa.gov/api/citations

# Rate Limiting
API_DELAY=1.0
MAX_REQUESTS_PER_MINUTE=60

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# Search Configuration
SEMANTIC_SEARCH_K=10
SIMILARITY_THRESHOLD=0.5

# Application Configuration
APP_NAME="Space Biology Knowledge Engine"
APP_VERSION=1.0.0
DEBUG_MODE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Development Settings
RELOAD=true
PORT=8000
HOST=0.0.0.0